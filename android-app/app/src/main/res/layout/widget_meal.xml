<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_meal_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="3dp">
    <LinearLayout
        android:id="@+id/widget_meal_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="7dp">
        <TextView
            android:id="@+id/widget_meal_moment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#6B7268"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/widget_meal_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#23281F"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_meal_ingredients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="7dp"
        android:textColor="#6B7268"
        android:textSize="11sp" />
</LinearLayout>